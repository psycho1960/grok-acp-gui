{
  "name": "grok-acp-gui",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "lint": "npm run check:theme && eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/gag-001.test.js tests/gag-002.test.js tests/gag-007.test.js tests/gag-008.test.js && vitest run && playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.13.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-store": "2.4.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^20.11.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.37.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
